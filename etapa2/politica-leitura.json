{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListarSoORelatorios",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::relatorios"
    },
    {
      "Sid": "BaixarObjetosDoRelatorios",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::relatorios/*"
    }
  ]
}
